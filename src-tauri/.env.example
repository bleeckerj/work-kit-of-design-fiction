# Copy this file to .env and fill in the values for local development
# Do NOT commit your real .env to git. Add .env to .gitignore.

# Which provider to use by default: "ollama" | "openai" | "lmstudio"
LLM_PROVIDER=lmstudio

# Local Ollama URL (default Ollama port 11434)
OLLAMA_URL=http://localhost:11434

# Local LM Studio URL (if using LM Studio)
LMSTUDIO_URL=http://localhost:1234

# OpenAI API Key (only used when LLM_PROVIDER=openai or when provider is set to openai)
# Get your key from https://platform.openai.com/account/api-keys
OPENAI_API_KEY=sk-REPLACE_WITH_YOUR_KEY

# Optional: default model (backend may override)
DEFAULT_MODEL=meta-llama-3.1-8b-instruct
